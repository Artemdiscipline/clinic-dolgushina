# Укажите подтверждённый публичный домен перед production-сборкой.
NEXT_PUBLIC_SITE_URL=https://example.ru

# Оставьте пустым для корневого домена или укажите путь проекта GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Для GitHub Pages укажите полный публичный адрес, чтобы загрузка JS и CSS шла из подпути проекта.
NEXT_PUBLIC_ASSET_PREFIX=
